import inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator;
import inet.networklayer.ipv4.RoutingTableRecorder;
import inet.node.ethernet.Eth10G;
import inet.node.inet.Router;
import inet.node.inet.StandardHost;
import simu5g.common.binder.Binder;
import simu5g.common.carrierAggregation.CarrierAggregation;
import simu5g.nodes.LteUe;
import simu5g.nodes.PgwStandard;
import simu5g.nodes.eNodeB;
import simu5g.world.radio.LteChannelControl;

// Simu5G v1.4.4 network-controlled LTE D2D/PC5 topology. Pure LTE UEs are
// intentional: v1.4.4's dual LTE/NR identity registration creates the same
// multicast RLC RX bearer twice for NrUe and aborts at runtime.
network Sim5gCv2xPc5BridgeNetwork
{
    parameters:
        int numVehicles = default(64);
        @display("i=block/network2;bgb=1000,1000");

    submodules:
        channelControl: LteChannelControl {
            @display("p=50,25;is=s");
        }
        routingRecorder: RoutingTableRecorder {
            @display("p=50,75;is=s");
        }
        configurator: Ipv4NetworkConfigurator {
            @display("p=50,125");
        }
        binder: Binder {
            @display("p=50,175;is=s");
        }
        carrierAggregation: CarrierAggregation {
            @display("p=50,258;is=s");
        }
        bridge: MetsrVeinsBridge;
        server: StandardHost {
            @display("p=212,118;is=n;i=device/server");
        }
        router: Router {
            @display("p=363,115;i=device/smallrouter");
        }
        pgw: PgwStandard {
            @display("p=527,116");
        }
        enb: eNodeB {
            @display("p=726,277;is=vl");
        }
        car[numVehicles]: LteUe {
            @display("p=628,411,row,80");
        }

    connections:
        server.pppg++ <--> Eth10G <--> router.pppg++;
        router.pppg++ <--> Eth10G <--> pgw.filterGate;
        pgw.pppg++ <--> Eth10G <--> enb.ppp;
}
